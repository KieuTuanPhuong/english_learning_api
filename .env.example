# Copy to .env and fill in. Never commit the result — .env is gitignored.
#   cp .env.example .env && chmod 600 .env
# Settings read this file via python-dotenv (config/settings.py).

# ============================================================ REQUIRED
# Postgres. Append ?sslmode=require for managed databases (RDS, Cloud SQL,
# Neon, Supabase). The +psycopg2 suffix from the old FastAPI app is tolerated.
DATABASE_URL=postgresql://english_learning_api:CHANGE_ME@localhost:5432/english_learning_api

# Generate a fresh one per environment — never reuse the dev value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every JWT, session and signed media link.
SECRET_KEY=CHANGE_ME

# ============================================================ PRODUCTION
# DEBUG=false is the production switch. It enables the HTTPS redirect, HSTS and
# secure cookies, and makes settings.py refuse to boot with a dev SECRET_KEY or
# a wildcard host. Leave it unset (or true) for local development.
DEBUG=false

# Comma-separated hostnames this API answers on. Required with DEBUG=false;
# a wildcard is rejected. Defaults to localhost only, so forgetting it fails
# loudly with DisallowedHost instead of trusting any Host header.
ALLOWED_HOSTS=api.example.com

# Browser origins allowed to call the API (the web client). Required in
# production; the default only covers http://localhost:3000.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Origins trusted for CSRF (Django admin login through the proxy). Defaults to
# https:// + each ALLOWED_HOSTS entry, so it is usually fine to leave unset.
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# ============================================================ AUTH
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================ OPTIONAL INFRA
# Redis-backed channel layer. REQUIRED once more than one worker process runs:
# without it a WebSocket broadcast only reaches clients on the same process.
# REDIS_URL=redis://localhost:6379/0

# Where collectstatic writes and WhiteNoise serves from. Default <project>/staticfiles.
# STATIC_ROOT=/var/lib/english-learning-api/static

# Where uploaded audio is stored. Default <project>/media. Must be writable by
# the app user and must survive deploys — do not put it inside the release dir
# if you deploy by replacing that directory.
# MEDIA_ROOT=/var/lib/english-learning-api/media

# How long a signed media link stays valid, in seconds. Default 7 days.
# MEDIA_URL_TTL=604800

# Let Nginx stream media after Django authorises it (frees the worker
# immediately). Needs the `internal` location block from docs/DEPLOYMENT.md.
# MEDIA_X_ACCEL_REDIRECT=false
# MEDIA_X_ACCEL_PREFIX=/protected-media/

# Database connection reuse. Defaults: 60s with DEBUG=false, 0 in dev.
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=require

# DEBUG | INFO | WARNING | ERROR. Default INFO.
# LOG_LEVEL=INFO

# ============================================================ SECURITY OVERRIDES
# Each defaults to ON when DEBUG=false. Only override if TLS is terminated
# somewhere this app cannot see, or for an internal-only deployment.
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# HSTS preload is close to irreversible — opt in only when you mean it.
# SECURE_HSTS_PRELOAD=false

# ============================================================ AI FEATURES
# All AI is off by default: every switch below falls back to a deterministic,
# offline mock, so the platform runs fully without any provider key.

# Grading of writing/speaking submissions. mock | llm
# AI_BACKEND=llm
# Teacher-feedback review + student mistake explanation. mock | llm
# AI_ASSIST_BACKEND=llm
# Pronunciation scoring. mock | gemini | azure
# PRONUNCIATION_BACKEND=gemini

# Google Gemini — the only provider that handles audio (speaking, pronunciation).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# NVIDIA NIM (build.nvidia.com) — text-only models.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3

# Per-task routing, "provider[:model]". Audio always goes to Gemini.
# WARNING: NIM queues Kimi K3 / DeepSeek V4 for 2-3 minutes before the first
# token, which exceeds Nginx's default 60s proxy_read_timeout and ties up a
# worker for the duration. Use gemini:* for anything a user waits on.
# AI_GRADING_MODEL=gemini:gemini-3.6-flash
# AI_ASSIST_MODEL=gemini:gemini-3.6-flash
# Retried once on this provider when the primary fails.
# AI_FALLBACK_PROVIDER=gemini
# NVIDIA_TIMEOUT=600

# CSV grade export is always on; PDF needs reportlab, which is not installed.
# REPORTS_PDF_ENABLED=false
